{
  "name": "@nativescript/tanstack-router",
  "version": "0.2.0",
  "description": "TanStack Router for NativeScript",
  "main": "index.cjs",
  "types": "index.d.ts",
  "files": [
    "index.cjs",
    "index.mjs",
    "*.d.ts",
    "*.d.mts",
    "solid",
    "react",
    "nativescript.vite.mjs",
    "nativescript.webpack.js",
    "solid-web-shim.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.mjs"
    },
    "./solid": {
      "types": "./solid/index.d.ts",
      "import": "./solid/index.mjs",
      "require": "./solid/index.cjs",
      "default": "./solid/index.mjs"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "import": "./react/index.mjs",
      "require": "./react/index.cjs",
      "default": "./react/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "nativescript": {
    "platforms": {
      "ios": "6.0.0",
      "android": "6.0.0"
    }
  },
  "scripts": {
    "clean": "rm -rf ../../dist/packages/tanstack-router",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && npm run typecheck && tsup --config tsup.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NativeScript/tanstack.git"
  },
  "keywords": [
    "NativeScript",
    "JavaScript",
    "TypeScript",
    "iOS",
    "Android",
    "TanStack Router",
    "SolidJS"
  ],
  "author": {
    "name": "NativeScript",
    "email": "oss@nativescript.org"
  },
  "bugs": {
    "url": "https://github.com/NativeScript/tanstack/issues"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/NativeScript/tanstack",
  "readmeFilename": "README.md",
  "peerDependencies": {
    "@nativescript-community/solid-js": ">=2.0.0",
    "@nativescript-community/react": ">=0.1.0",
    "@nativescript/core": ">=9.0.0",
    "solid-js": ">=2.0.0 <3.0.0",
    "@solidjs/web": ">=2.0.0 <3.0.0",
    "react": ">=19.0.0",
    "@tanstack/solid-router": ">=2.0.0-rc.12 <3.0.0",
    "@tanstack/react-router": ">=1.169.0",
    "@tanstack/history": ">=1.161.0"
  },
  "peerDependenciesMeta": {
    "@nativescript-community/solid-js": {
      "optional": true
    },
    "@nativescript-community/react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@solidjs/web": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@tanstack/solid-router": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "~5.9.0",
    "vitest": "^4.1.5",
    "@types/react": "^19.0.0",
    "@tanstack/solid-router": "2.0.0-rc.12",
    "@tanstack/react-router": "~1.170.46",
    "@tanstack/history": "1.162.5",
    "@tanstack/router-core": "1.171.39"
  }
}
